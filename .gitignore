# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Build output
/build/

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Local configuration (copy from config.example.yaml)
/config.yaml

# SQLite database files
*.db
*.db-wal
*.db-shm

# Editor/IDE
# .idea/
# .vscode/

# Compiled binary in the repository root (historical accident; build into build/ instead).
/warnflux

# Secrets: client certificates and their passwords must never be committed.
# A .p12 identifies the station to a provider (GDDKiA KPD today); leaking it
# would let anyone pull the data in our name. Keep them in the configuration
# volume (config/, build/, /srv/docker/.../config), all of which are ignored.
*.p12
*.pfx
*.pem
*.key
*.pass
*.crt
/secrets/
